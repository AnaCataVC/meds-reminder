#!/bin/sh
# Git pre-push hook to prevent pushing broken test suites

echo "===================================================="
echo " [pre-push hook] Running automated unit test checks "
echo "===================================================="

if command -v powershell >/dev/null 2>&1; then
    powershell -NoProfile -ExecutionPolicy Bypass -File "./scripts/check.ps1" -Fast
    EXIT_CODE=$?
elif command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -File "./scripts/check.ps1" -Fast
    EXIT_CODE=$?
else
    ./gradlew testDebugUnitTest
    EXIT_CODE=$?
fi

if [ $EXIT_CODE -ne 0 ]; then
    echo "===================================================="
    echo " [pre-push hook] FAILED: Unit tests must pass prior to pushing."
    echo "===================================================="
    exit 1
fi

echo "===================================================="
echo " [pre-push hook] PASSED: Safe to push."
echo "===================================================="
exit 0
